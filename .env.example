# Copy this file to .env and fill in real values.
# Never commit .env — only .env.example placeholders live in git.

# --- Application (server) -------------------------------------------------
APP_BASE_URL=http://localhost:3000

# --- PostgreSQL -----------------------------------------------------------
# Local: docker-compose service. Production: Supabase transaction pooler
# (prepare:false is configured in src/server/db).
DATABASE_URL=postgresql://cashier:cashier@localhost:5434/cashier
# Used by drizzle-kit migrations when a direct session connection is needed.
DATABASE_MIGRATION_URL=postgresql://cashier:cashier@localhost:5434/cashier

# --- Supabase -------------------------------------------------------------
# Local placeholders work for boot; create a Supabase project for real Auth.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=local-publishable-key
# Server-only; only needed for privileged admin operations.
SUPABASE_SECRET_KEY=

# --- Optional -------------------------------------------------------------
INTERNAL_JOB_SECRET=
ERROR_TRACKING_DSN=
