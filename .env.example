# Copy this file to .env and fill in real values.
# Never commit .env — only .env.example placeholders live in git.

# --- Application (server) -------------------------------------------------
APP_BASE_URL=http://localhost:3000

# --- PostgreSQL -----------------------------------------------------------
# Local: docker-compose service. Production: Supabase transaction pooler
# (prepare:false is configured in src/server/db).
DATABASE_URL=postgresql://cashier:cashier@localhost:5434/cashier
# Used by drizzle-kit migrations when a direct session connection is needed.
DATABASE_MIGRATION_URL=postgresql://cashier:cashier@localhost:5434/cashier

# --- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only; only needed for privileged admin operations.
SUPABASE_SECRET_KEY=sb_secret_...

# --- Seeded demo staff (used by e2e login tests) ---------------------------
E2E_ADMIN_EMAIL=admin@cashier.local
E2E_ADMIN_PASSWORD=change-me
# Optional second demo account with the restricted Cashier role.
# Uncomment locally; leave commented out in CI.
# E2E_CASHIER_EMAIL=cashier@cashier.local
# E2E_CASHIER_PASSWORD=change-me

# --- Optional -------------------------------------------------------------
INTERNAL_JOB_SECRET=
ERROR_TRACKING_DSN=
